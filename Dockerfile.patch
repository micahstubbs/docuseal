# Patch layer for dataroom-sign (docuseal-ok9).
#
# The full Dockerfile cannot rebuild today: its pdfium download
# (docusealco/pdfium-binaries release 20260613) returns 404 and the layer is no
# longer cached. When the only change since the running image is Ruby code, layer
# the changed files onto that image instead:
#
#   docker build -f Dockerfile.patch --build-arg BASE=dataroom-sign:latest -t dataroom-sign:<tag> .
#
# List every changed file below; `git diff <image commit> HEAD --stat -- app config lib`
# must show nothing else.
ARG BASE=dataroom-sign:latest
FROM ${BASE}
COPY --chown=docuseal:docuseal app/controllers/submit_form_controller.rb /app/app/controllers/submit_form_controller.rb
# docuseal-mnb: per-signer notification email to the sender.
COPY --chown=docuseal:docuseal app/jobs/process_submitter_completion_job.rb /app/app/jobs/process_submitter_completion_job.rb
COPY --chown=docuseal:docuseal app/mailers/submitter_mailer.rb /app/app/mailers/submitter_mailer.rb
COPY --chown=docuseal:docuseal app/models/account_config.rb /app/app/models/account_config.rb
COPY --chown=docuseal:docuseal app/views/submitter_mailer/submitter_signed_notification_email.html.erb /app/app/views/submitter_mailer/submitter_signed_notification_email.html.erb
COPY --chown=docuseal:docuseal config/locales/i18n.yml /app/config/locales/i18n.yml
